{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/login", "destination": "/login.html" },
    { "source": "/register", "destination": "/register.html" },
    { "source": "/passenger/dashboard", "destination": "/passenger-dashboard.html" },
    { "source": "/driver/dashboard", "destination": "/driver-dashboard.html" },
    { "source": "/(.*)", "destination": "/$1" }
  ]
}
